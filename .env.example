# Copy to .dev.vars for `npm run dev` (Cloudflare) — never commit real values.
# In production set these as encrypted secrets in the Cloudflare Pages dashboard
# (Settings → Variables and Secrets) or Vercel (Settings → Environment Variables).

# lava.top → Integrations → API → create key
LAVA_API_KEY=
# The offer (price) id of your "LocalLedger Pro" product in lava.top
LAVA_OFFER_ID=
# Optional: exact product name in lava.top; claims for other products are refused
LAVA_PRODUCT_NAME=LocalLedger Pro
# Shared secret you also enter in lava.top webhook settings (API key auth or Basic auth password)
LAVA_WEBHOOK_SECRET=
# Output of `npm run keys` (one line of JSON)
LICENSE_PRIVATE_JWK=
# Public URL of the site, used for payment return links
SITE_URL=https://localledger.pages.dev
# Optional: Telegram notifications about sales/refunds/chargebacks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: token for GET /api/stats?token=...
ADMIN_TOKEN=
