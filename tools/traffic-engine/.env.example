# Optional. Without these the engine writes template replies (no AI cost).
# Any OpenAI-compatible chat endpoint works, e.g.
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<a model id ending in :free>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Hard cap on LLM calls per run (generation + retries).
LLM_MAX_CALLS=20
# Optional Stack Exchange key (raises the 300 requests/day anonymous quota).
STACKEXCHANGE_KEY=
