# Эдит — настройки. Скопируйте в edith/.env и запустите:  node --env-file=edith/.env edith/server.mjs
# (или экспортируйте переменные в окружение вручную)

# Ключ Claude API. Берётся на https://console.anthropic.com — хранится ТОЛЬКО на вашем Mac.
ANTHROPIC_API_KEY=sk-ant-...

# Модель (по умолчанию claude-opus-5-5). Можно claude-sonnet-5-5 — дешевле и быстрее.
EDITH_MODEL=claude-opus-5-5

# Порт локального сервера (по умолчанию 4330).
EDITH_PORT=4330

# Веб-поиск через Claude. Поставьте 0, чтобы отключить.
EDITH_WEBSEARCH=1

# Произвольные команды терминала и AppleScript. ВЫКЛЮЧЕНО по умолчанию — это
# мощный и опасный доступ. Включайте только осознанно: EDITH_ALLOW_SHELL=1
# EDITH_ALLOW_SHELL=0
