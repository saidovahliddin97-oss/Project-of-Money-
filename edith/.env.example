# Эдит — настройки. Скопируйте в edith/.env.
# Выберите «мозг» (EDITH_PROVIDER). Все варианты ниже — БЕСПЛАТНЫЕ.

# ── Вариант A (по умолчанию): Ollama, облачная модель. Считает на серверах
#    Ollama — Mac и батарея почти не нагружаются. Бесплатно; нужен вход в
#    аккаунт Ollama (приложение Ollama → Sign In). Ключ не нужен.
#    Хотите полностью офлайн (но с нагрузкой на Mac) — EDITH_MODEL=llama3.1
#    и в Терминале: ollama pull llama3.1
EDITH_PROVIDER=ollama
EDITH_MODEL=gemma4:31b-cloud

# ── Вариант B: Groq — облачно, бесплатно, очень быстро. Нужен бесплатный ключ
#    с console.groq.com (без карты). Раскомментируйте три строки:
# EDITH_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# EDITH_MODEL=llama-3.3-70b-versatile

# ── Вариант C: Google Gemini — облачно, бесплатный тариф. Ключ с
#    aistudio.google.com/app/apikey (без карты). Поддерживает «зрение».
# EDITH_PROVIDER=gemini
# GEMINI_API_KEY=...
# EDITH_MODEL=gemini-2.0-flash
# EDITH_VISION=1

# ── Вариант D: OpenRouter — облачно, есть бесплатные модели (:free).
# EDITH_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# EDITH_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Бесшовное переключение при лимите ──────────────────────────────────────
# Если текущая модель упрётся в лимит/ошибку, Эдит молча переключится на
# следующую из цепочки (нужны ключи для облачных — иначе они пропускаются).
# Порядок можно поменять. Чтобы задать запасные, впишите ключи выше.
EDITH_CHAIN=ollama,groq,gemini,openrouter,mistral

# ── Общие настройки ────────────────────────────────────────────────────────
# Порт локального сервера (по умолчанию 4330).
EDITH_PORT=4330

# Веб-поиск (бесплатный, через DuckDuckGo, без ключа). 0 — отключить.
EDITH_WEBSEARCH=1

# Живое зрение: Эдит смотрит на экран перед ответом. 0 — отключить.
EDITH_SCREEN=1

# Произвольные команды терминала и AppleScript. ВЫКЛЮЧЕНО по умолчанию —
# мощный и опасный доступ. Включайте только осознанно: EDITH_ALLOW_SHELL=1
# EDITH_ALLOW_SHELL=0

# Для нестандартного OpenAI-совместимого сервера можно задать базовый URL вручную:
# EDITH_BASE_URL=http://localhost:11434/v1
